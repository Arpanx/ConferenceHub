<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<SpaRoot>$(MSBuildProjectDirectory)\..\ClientApp\</SpaRoot>
		<SpaDist>$(SpaRoot)dist\ClientApp\browser\</SpaDist>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
	</ItemGroup>

	<!-- Build Angular before publishing -->
	<Target Name="BuildAngular" BeforeTargets="Publish">

		<Message Importance="high"
				 Text="========== Building Angular application ==========" />

		<Exec
		  Command="npm.cmd install"
		  WorkingDirectory="$(SpaRoot)" />

		<Exec
		  Command="ng.cmd build --configuration production"
		  WorkingDirectory="$(SpaRoot)" />

	</Target>

	<!-- Include Angular files in ASP.NET Core publish -->
	<Target Name="IncludeAngularInPublish"
			AfterTargets="BuildAngular">

		<ItemGroup>

			<ResolvedFileToPublish Include="$(SpaDist)**\*">
				<RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>

		</ItemGroup>

	</Target>

</Project>